# Core
DATABASE_URL=postgresql://mdawra:mdawra@localhost:5432/mdawra
PORT=4000
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
REFRESH_EXPIRES_IN=30d
UPLOAD_DIR=./uploads
PUBLIC_URL=http://localhost:4000
MAX_UPLOAD_BYTES=5242880
CORS_ORIGINS=*

# WhatsApp Cloud API (Meta) — required for the WhatsApp ordering bot
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_SESSION_TTL_MINUTES=60

# Payment gateway: manual (disabled) | myfatoorah | mock (dev only)
PAYMENT_PROVIDER=manual
MYFATOORAH_API_KEY=
MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com
MYFATOORAH_CURRENCY=KWD
