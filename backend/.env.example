# Core
DATABASE_URL="postgresql://mdawra:mdawra@localhost:5432/mdawra?schema=public"
# In production use Neon's POOLED string for DATABASE_URL and the UNPOOLED one here.
# Locally, just repeat the same value.
DIRECT_URL="postgresql://mdawra:mdawra@localhost:5432/mdawra?schema=public"
PORT=4000
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="1d"
REFRESH_EXPIRES_IN="30d"
# Leave CLOUDINARY_URL unset for local disk storage (local dev).
# Set it in production — copy the value from the Cloudinary dashboard.
# CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
UPLOAD_DIR="./uploads"
PUBLIC_URL="http://localhost:4000"
MAX_UPLOAD_BYTES=5242880
CORS_ORIGINS="http://localhost:5173"

SEED_ADMIN_EMAIL="admin@mdawra.com"
SEED_ADMIN_PASSWORD="Admin@123"

# WhatsApp Cloud API (Meta) — required for the WhatsApp ordering bot
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_SESSION_TTL_MINUTES=60

# Payment gateway: manual (disabled) | myfatoorah | mock (dev only)
PAYMENT_PROVIDER=manual
MYFATOORAH_API_KEY=
MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com
MYFATOORAH_CURRENCY=KWD
