DATABASE_URL="postgresql://mdawra:mdawra@localhost:5432/mdawra?schema=public"
# In production use Neon's POOLED string for DATABASE_URL and the UNPOOLED one here.
# Locally, just repeat the same value.
DIRECT_URL="postgresql://mdawra:mdawra@localhost:5432/mdawra?schema=public"
PORT=4000
