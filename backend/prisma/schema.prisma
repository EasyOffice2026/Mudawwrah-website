generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  KNET
  CARD
  WHATSAPP
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  phone     String?
  role      Role     @default(CUSTOMER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Category {
  id           String     @id @default(uuid())
  nameEn       String
  nameAr       String
  slug         String     @unique
  subtitleEn   String?
  subtitleAr   String?
  displayStyle String     @default("list") // "list" | "grid"
  displayOrder Int        @default(0)
  isVisible    Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  items        MenuItem[]
}

model MenuItem {
  id            String                @id @default(uuid())
  nameEn        String
  nameAr        String?
  descriptionEn String?
  descriptionAr String?
  price         Decimal               @db.Decimal(10, 3)
  categoryId    String
  category      Category              @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  imageId       String?
  image         Media?                @relation(fields: [imageId], references: [id])
  isAvailable   Boolean               @default(true)
  isOutOfStock  Boolean               @default(false)
  isFeatured    Boolean               @default(false)
  isCustomizable Boolean              @default(false)
  displayOrder  Int                   @default(0)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  options       CustomizationOption[]
  orderItems    OrderItem[]
}

model CustomizationOption {
  id           String   @id @default(uuid())
  menuItemId   String
  menuItem     MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  groupEn      String
  groupAr      String?
  nameEn       String
  nameAr       String?
  extraPrice   Decimal  @default(0) @db.Decimal(10, 3)
  isRequired   Boolean  @default(false)
  maxSelect    Int      @default(1)
  displayOrder Int      @default(0)
}

model Order {
  id            String        @id @default(uuid())
  orderNumber   String        @unique
  userId        String?
  user          User?         @relation(fields: [userId], references: [id])
  customerName  String
  customerPhone String
  address       String?
  notes         String?
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @default(CASH)
  subtotal      Decimal       @db.Decimal(10, 3)
  deliveryFee   Decimal       @default(0) @db.Decimal(10, 3)
  serviceCharge Decimal       @default(0) @db.Decimal(10, 3)
  total         Decimal       @db.Decimal(10, 3)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         OrderItem[]
}

model OrderItem {
  id             String   @id @default(uuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId     String?
  menuItem       MenuItem? @relation(fields: [menuItemId], references: [id])
  nameEn         String
  nameAr         String?
  unitPrice      Decimal  @db.Decimal(10, 3)
  quantity       Int
  lineTotal      Decimal  @db.Decimal(10, 3)
  customizations Json?
}

model Banner {
  id           String    @id @default(uuid())
  titleEn      String?
  titleAr      String?
  imageId      String?
  image        Media?    @relation(fields: [imageId], references: [id])
  linkUrl      String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Media {
  id           String     @id @default(uuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  thumbnailUrl String?
  createdAt    DateTime   @default(now())
  menuItems    MenuItem[]
  banners      Banner[]
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
