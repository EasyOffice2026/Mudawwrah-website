generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for queries.
  url       = env("DATABASE_URL")
  // Direct (unpooled) connection — migrations cannot run through PgBouncer.
  // Locally set this to the same value as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  KNET
  CARD
  APPLE_PAY
  WHATSAPP
}

enum OrderType {
  DELIVERY
  PICKUP
}

enum PromotionType {
  PERCENT
  FIXED
  FREE_DELIVERY
}

/// One restaurant on the platform. Every piece of content below belongs to
/// exactly one tenant, which is what makes the codebase resellable.
model Tenant {
  id           String  @id @default(uuid())
  slug         String  @unique
  nameEn       String
  nameAr       String
  taglineEn    String?
  taglineAr    String?
  cuisineEn    String?
  cuisineAr    String?
  /// Hero shot shown on the platform landing page and behind the store header.
  heroUrl      String?
  /// Square mark shown in the storefront info card and the splash animation.
  logoUrl      String?
  /// Storefront credibility strip: rating, review count and prep window.
  rating       Decimal? @db.Decimal(2, 1)
  ratingCount  Int      @default(0)
  prepMinutesMin Int    @default(15)
  prepMinutesMax Int    @default(25)
  /// Hex colours, applied at runtime as CSS variables.
  brandColor   String  @default("#B00020")
  brandDark    String  @default("#8A0019")
  brandLight   String  @default("#F6E4E7")
  accentColor  String  @default("#FF6B00")
  currency     String  @default("KWD")
  country      String  @default("KW")
  /// Reserved for the paid tier: restaurant.com instead of a subdomain.
  customDomain String? @unique
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  categories Category[]
  items      MenuItem[]
  orders     Order[]
  banners    Banner[]
  media      Media[]
  settings   Setting[]
  promotions Promotion[]
}

/// A voucher a customer can apply at checkout. Discounts are always recomputed
/// server-side from this row, never trusted from the client.
model Promotion {
  id            String        @id @default(uuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code          String
  titleEn       String
  titleAr       String?
  subtitleEn    String?
  subtitleAr    String?
  type          PromotionType @default(PERCENT)
  /// Percent (0-100) for PERCENT, an absolute amount for FIXED, ignored for FREE_DELIVERY.
  value         Decimal       @default(0) @db.Decimal(10, 3)
  /// Subtotal the cart must reach before the code applies.
  minOrder      Decimal       @default(0) @db.Decimal(10, 3)
  /// Caps a PERCENT discount. Null means uncapped.
  maxDiscount   Decimal?      @db.Decimal(10, 3)
  isActive      Boolean       @default(true)
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
}

model User {
  id        String   @id @default(uuid())
  /// Null means a platform-level operator who can administer every tenant.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email     String   @unique
  password  String
  name      String
  phone     String?
  role      Role     @default(CUSTOMER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@index([tenantId])
}

model Category {
  id           String     @id @default(uuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nameEn       String
  nameAr       String
  slug         String
  subtitleEn   String?
  subtitleAr   String?
  displayStyle String     @default("list") // "list" | "grid"
  displayOrder Int        @default(0)
  isVisible    Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  items        MenuItem[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model MenuItem {
  id             String                @id @default(uuid())
  tenantId       String
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nameEn         String
  nameAr         String?
  descriptionEn  String?
  descriptionAr  String?
  price          Decimal               @db.Decimal(10, 3)
  /// Pre-discount price. When set and above `price`, the menu strikes it
  /// through beside the live price and shows a discount badge.
  compareAtPrice Decimal?              @db.Decimal(10, 3)
  categoryId     String
  category       Category              @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  imageId        String?
  image          Media?                @relation(fields: [imageId], references: [id])
  isAvailable    Boolean               @default(true)
  isOutOfStock   Boolean               @default(false)
  isFeatured     Boolean               @default(false)
  isTopRated     Boolean               @default(false)
  isCustomizable Boolean               @default(false)
  /// Per-serving nutrition, surfaced under the item name like a health menu.
  calories       Int?
  protein        Int?
  fat            Int?
  carbs          Int?
  displayOrder   Int                   @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  options        CustomizationOption[]
  orderItems     OrderItem[]

  @@index([tenantId])
}

model CustomizationOption {
  id           String   @id @default(uuid())
  menuItemId   String
  menuItem     MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  groupEn      String
  groupAr      String?
  nameEn       String
  nameAr       String?
  extraPrice   Decimal  @default(0) @db.Decimal(10, 3)
  isRequired   Boolean  @default(false)
  maxSelect    Int      @default(1)
  displayOrder Int      @default(0)
}

model Order {
  id            String        @id @default(uuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderNumber   String
  userId        String?
  user          User?         @relation(fields: [userId], references: [id])
  customerName  String
  customerPhone String
  address       String?
  notes         String?
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @default(CASH)
  /// Pickup orders are never charged a delivery fee and carry no address.
  orderType     OrderType     @default(DELIVERY)
  subtotal      Decimal       @db.Decimal(10, 3)
  deliveryFee   Decimal       @default(0) @db.Decimal(10, 3)
  serviceCharge Decimal       @default(0) @db.Decimal(10, 3)
  tax           Decimal       @default(0) @db.Decimal(10, 3)
  /// Applied promo code and the amount it took off, both resolved server-side.
  promoCode     String?
  discount      Decimal       @default(0) @db.Decimal(10, 3)
  tip           Decimal       @default(0) @db.Decimal(10, 3)
  cutlery       Boolean       @default(false)
  deliveryNote  String?
  total         Decimal       @db.Decimal(10, 3)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         OrderItem[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
}

model OrderItem {
  id             String    @id @default(uuid())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId     String?
  menuItem       MenuItem? @relation(fields: [menuItemId], references: [id])
  nameEn         String
  nameAr         String?
  unitPrice      Decimal   @db.Decimal(10, 3)
  quantity       Int
  lineTotal      Decimal   @db.Decimal(10, 3)
  customizations Json?
}

model Banner {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  titleEn      String?
  titleAr      String?
  imageId      String?
  image        Media?    @relation(fields: [imageId], references: [id])
  linkUrl      String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId])
}

model Media {
  id           String     @id @default(uuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  thumbnailUrl String?
  createdAt    DateTime   @default(now())
  menuItems    MenuItem[]
  banners      Banner[]

  @@index([tenantId])
}

model Setting {
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@id([tenantId, key])
}
