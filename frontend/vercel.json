{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/uploads/:file*", "destination": "/api/image?file=:file*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
