# The API runs on Render (Singapore, with a disk for uploaded images), not on a laptop behind a
# tunnel as before, so this address no longer changes. Uploaded images are fetched from the same
# host by api/image.js: set UPSTREAM_API_URL in the Vercel project to https://mudawwrah-website.onrender.com (no /api).
VITE_API_URL=https://mudawwrah-website.onrender.com/api

# Powers the checkout pin-drop map (LocationPicker.jsx). Restricted at the
