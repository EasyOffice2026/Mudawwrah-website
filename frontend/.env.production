# Backend reached through a tunnel to this machine. Switched from ngrok to a
# Cloudflare quick tunnel on 2026-09-21 after the ngrok free tier hit its
# monthly bandwidth cap (ERR_NGROK_725) mid-launch. Like ngrok's free tier,
# this hostname is not stable — it changes whenever the tunnel restarts, so
# this needs updating (and the site redeploying) each time it does. Neither
# is a real fix; the actual fix is moving the backend off this laptop.
VITE_API_URL=https://rod-encryption-approaches-inspector.trycloudflare.com/api

# Powers the checkout pin-drop map (LocationPicker.jsx). Restricted at the
# Google Cloud end to madawarah.com — a Vite env var like this ships in the
# public JS bundle regardless, so the referrer restriction is the actual
# security boundary, not keeping this value secret.
VITE_GOOGLE_MAPS_API_KEY=AIzaSyD2TyL5GZGlAl7Zp0aoMqkMvMaq7wSVfbE
